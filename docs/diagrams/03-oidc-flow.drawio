        <mxCell id="lg-s5" value="STS returns short-lived credentials to the job" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="578" y="739" width="440" height="20" as="geometry" /></mxCell>
